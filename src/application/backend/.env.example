############### For Local Development Only ###############

# Environment: "production", "development", or "testing"
# - "production": Uses AWS RDS and SSM for secrets
# - "development" or "testing": Uses local SQLite database
ENVIRONMENT=development

# Fallback to Local DB (used when ENVIRONMENT is "development" or "testing")
ACCESS_TOKEN_SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///./test.db

# AWS Credentials (used when ENVIRONMENT is "production")
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# Beckrock Model ID
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0

