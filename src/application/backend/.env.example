# FastAPI Configuration
ACCESS_TOKEN_SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///./test.db

# AWS Bedrock Configuration
# For local testing, set these credentials:
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# Bedrock Model Configuration
# Available models:
# - openai.gpt-oss-120b-1:0 (Default)
# - meta.llama4-maverick-17b-instruct-v1:0
# - anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0

# Note: When deployed to ECS, AWS credentials are not needed.
# The ECS task will inherit IAM role permissions automatically.